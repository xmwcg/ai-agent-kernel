{
  "name": "ai-agent-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal runnable AI Agent kernel (MVP) built following the ai-agent-fullstack-dev 7-phase workflow.",
  "scripts": {
    "repl": "tsx src/agent/index.ts",
    "server": "tsx src/agent/server.ts",
    "build": "tsc -p tsconfig.json",
    "web": "npm --prefix web run dev",
    "webbuild": "npm --prefix web run build",
    "webstart": "npm --prefix web run start",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
