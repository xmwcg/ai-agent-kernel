# LLM (任意 OpenAI 兼容端点, 无 key 时内核降级为本地工具模式)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选搜索 (Tavily 等, 留空则搜索工具返回提示)
SEARCH_API_KEY=

# 沙箱允许执行的命令白名单 (逗号分隔, 留空用内置默认)
EXEC_ALLOWLIST=

# 运行端口 / 环境
PORT=3000
NODE_ENV=development

# Python 解释器路径 (留空则自动探测 python3/python)
PYTHON_BIN=
