# LLM (任意 OpenAI 兼容端点, 无 key 时内核降级为本地工具模式)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选搜索 (Tavily 等, 留空则搜索工具返回提示)
SEARCH_API_KEY=

# 沙箱允许执行的命令白名单 (逗号分隔, 留空用内置默认)
EXEC_ALLOWLIST=

# 运行端口 / 环境
PORT=3000
NODE_ENV=development

# Python 解释器路径 (留空则自动探测 python3/python)
PYTHON_BIN=

# ===== 企业层 (Enterprise) =====
# 管理员令牌: 留空则内核启动时自动生成一个 (会打印到控制台), 生产环境请固定此值
ADMIN_TOKEN=
# 品牌化: 企业名称 / Logo (前端与后台展示)
ENTERPRISE_NAME=AI Agent Kernel
ENTERPRISE_LOGO=

